    {
      "name": "1 - Autenticação",
      "item": [
        {
          "name": "Registrar usuário comum",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/registrar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "registrar"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Maria Silva\",\n  \"email\": \"{{emailUsuario}}\",\n  \"senha\": \"Senha@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"emailUsuario\", `maria.${Date.now()}@teste.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"usuarioId\", json.id);",
                  "pm.test(\"Perfil é Usuario\", () => pm.expect(json.perfil).to.eql(\"Usuario\"));",
                  "pm.test(\"Não expõe a senha\", () => pm.expect(pm.response.text().toLowerCase()).to.not.include(\"senha\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login usuário comum",
